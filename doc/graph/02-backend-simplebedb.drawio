        <mxCell id="n_authroutes" value="Auth routes&lt;br&gt;POST /auth/login (public)&lt;br&gt;POST /auth/register (public)&lt;br&gt;POST /auth/forgot-password (public)&lt;br&gt;POST /auth/reset-password/:userId (public)&lt;br&gt;GET /auth/auth-check 🔒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
