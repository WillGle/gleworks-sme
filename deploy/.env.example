# Copy to deploy/.env and fill in. deploy/.env is git-ignored (secrets).

# Public domain — create a DNS A record pointing it to your VPS IP first.
DOMAIN=demo.yourdomain.com

# Backend JWT signing secret. Generate one:  openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# Grafana admin password (login via SSH tunnel to :3000, or grafana.$DOMAIN).
GRAFANA_ADMIN_PASSWORD=replace-me

# Expose a public READ-ONLY Grafana at grafana.$DOMAIN
# (also uncomment the grafana block in deploy/Caddyfile and add its DNS record).
GRAFANA_ANON_ENABLED=false

# Optional image tag.
TAG=latest
