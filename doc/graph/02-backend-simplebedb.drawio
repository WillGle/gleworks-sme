        </mxCell>
        <mxCell id="n_usersroutes" value="Users routes&lt;br&gt;GET /users 🔒 admin&lt;br&gt;GET /users/:userId 🔒 self/admin&lt;br&gt;PUT /users/:userId 🔒 self/admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
