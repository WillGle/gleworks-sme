        <!-- Column C: fallback DR -->
        <mxCell id="n_colC" value="deploy/docker-compose.fallback.yml&lt;br&gt;DR / 2 GB RAM VPS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
