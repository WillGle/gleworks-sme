        <mxCell id="n_c_note" value="No Prometheus / Grafana&lt;br&gt;(dropped to fit a 2 GB RAM VPS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
