# Caddy auto-provisions HTTPS (Let's Encrypt) for $DOMAIN.
# A DNS A record for $DOMAIN must point to this VPS before first boot.
{$DOMAIN} {
	encode gzip zstd
	reverse_proxy frontend:80
}

# Optional: public READ-ONLY Grafana at grafana.$DOMAIN.
