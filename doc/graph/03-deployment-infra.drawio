        </mxCell>
        <mxCell id="n_c_pgnote" value="commented-out: future Postgres env vars&lt;br&gt;— see doc/POSTGRES_MIGRATION_PLAN.md" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
