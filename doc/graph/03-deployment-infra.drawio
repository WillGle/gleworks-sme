        <!-- Dockerfiles -->
        <mxCell id="n_frontenddockerfile" value="Dockerfile (root)&lt;br&gt;node:20-alpine build → nginx:alpine runtime&lt;br&gt;copies dist/ + nginx.conf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n_backenddockerfile" value="simpleBEDB/Dockerfile&lt;br&gt;node:20 deps → node:20-slim runtime&lt;br&gt;node --max-old-space-size=128" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="580" width="440" height="70" as="geometry" />
        </mxCell>

        <!-- Provisioning / tooling -->
        <mxCell id="n_ansible" value="Ansible playbook&lt;br&gt;installs Docker + compose plugin&lt;br&gt;clones repo → /opt/gleworks&lt;br&gt;renders deploy/.env (mode 0600)&lt;br&gt;compose pull + up -d&lt;br&gt;(default: docker-compose.prod.yml)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n_makefile" value="deploy/Makefile&lt;br&gt;up (build+start) · deploy (pull+start)&lt;br&gt;pull · down · logs · ps · config&lt;br&gt;validate (promtool + caddy validate)&lt;br&gt;build-push (manual image build,&lt;br&gt;linux/amd64, for the low-RAM VPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="680" width="440" height="160" as="geometry" />
        </mxCell>
        <mxCell id="n_buildpush" value="Manual build-push&lt;br&gt;dev box builds frontend + backend&lt;br&gt;(linux/amd64) → pushes to&lt;br&gt;NAMESPACE/glework-* (default 'gleammy')&lt;br&gt;VPS then pulls via deploy/.env overrides" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="680" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n_cicdexternal" value="GitHub Actions → GHCR →&lt;br&gt;SSH deploy (fallback stack)&lt;br&gt;— see 05-cicd-pipeline.drawio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="680" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n_envfile" value="deploy/.env&lt;br&gt;(git-ignored secrets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="860" width="200" height="60" as="geometry" />
