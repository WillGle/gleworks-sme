        <mxCell id="n_title" value="GleWorks — Deployment &amp; Infrastructure" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n_subtitle" value="Three docker-compose topologies, built from the same two Dockerfiles, brought up by Ansible, a Makefile, or CI/CD." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1000" height="24" as="geometry" />
        </mxCell>

        <!-- Column A: local dev/smoke -->
        <mxCell id="n_colA" value="docker-compose.yml (repo root)&lt;br&gt;local dev / pre-ship smoke test" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="380" height="440" as="geometry" />
        </mxCell>
        <mxCell id="n_a_backend" value="backend&lt;br&gt;127.0.0.1:3001 → :3001 (host-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_a_frontend" value="frontend&lt;br&gt;8080 → 80 (host-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="225" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_a_prometheus" value="prometheus&lt;br&gt;127.0.0.1:9090 → :9090" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_a_grafana" value="grafana&lt;br&gt;127.0.0.1:3000 → :3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="355" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_a_note" value="No Caddy / no TLS. Run directly from&lt;br&gt;repo root: docker compose up -d --build&lt;br&gt;(not part of deploy/Makefile).&lt;br&gt;Smoke-tests the same images before shipping." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="340" height="110" as="geometry" />
        </mxCell>

        <!-- Column B: prod full stack -->
