<mxfile host="Electron" modified="2026-07-04T00:00:00.000Z" agent="GleWorks-docgen" etag="gleworks-cicd" version="24.7.17" type="device">
  <diagram id="gleworks-cicd" name="05 - CICD Pipeline">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n_title" value="GleWorks — CI/CD Pipelines" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n_subtitle" value="Two independent pipelines exist in this repo. GitHub Actions is the current, full path; Jenkins is a legacy, frontend-only path." style="text;html=1;fontSize=12;fontStyle=2;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n_banner" value="⚠ Root README claims Jenkins is the active pipeline and that GitHub Actions is no longer present — but .github/workflows/ci-cd.yml exists, builds and pushes both images to GHCR, can deploy over SSH, and has uncommitted local changes right now. Treat it as primary; Jenkins is legacy." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1580" height="48" as="geometry" />
        </mxCell>

        <!-- GitHub Actions lane -->
        <mxCell id="n_gha_lane" value="GitHub Actions — .github/workflows/ci-cd.yml  (current / primary)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="1580" height="500" as="geometry" />
        </mxCell>

        <mxCell id="n_gha_trigger" value="Triggers: push to main · tag v* · pull_request · workflow_dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="1520" height="40" as="geometry" />
        </mxCell>

        <mxCell id="n_ci_subgroup" value="job: ci — Lint · Type-check · Test · Build (every push &amp; PR)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="1520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_ci1" value="Setup&lt;br&gt;checkout · setup-node 20&lt;br&gt;(npm cache) · npm ci" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="275" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_ci2" value="Lint&lt;br&gt;npm run lint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="275" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_ci3" value="Type-check&lt;br&gt;npm run type-check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="275" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_ci4" value="Test&lt;br&gt;npm run test:run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="275" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_ci5" value="Build&lt;br&gt;npm run build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1280" y="275" width="280" height="55" as="geometry" />
        </mxCell>

        <mxCell id="n_images_subgroup" value="job: images (needs: ci) — build &amp; push to GHCR (image push skipped on pull_request)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="1520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_img1" value="Setup buildx + GHCR login&lt;br&gt;(login/push skipped on pull_request)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="405" width="460" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_img2" value="Build &amp; push frontend&lt;br&gt;ghcr.io/owner/glework-frontend&lt;br&gt;tags: latest (default branch), sha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="405" width="460" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_img3" value="Build &amp; push backend&lt;br&gt;ghcr.io/owner/glework-backend&lt;br&gt;tags: latest (default branch), sha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="405" width="460" height="55" as="geometry" />
        </mxCell>

        <mxCell id="n_deploy_subgroup" value="job: deploy (needs: images) — only if ref=main AND repo var DEPLOY_ENABLED=true" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="1520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n_dep1" value="SSH to VPS&lt;br&gt;secrets: VPS_HOST, VPS_USER,&lt;br&gt;VPS_SSH_KEY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="535" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_dep2" value="git pull --ff-only&lt;br&gt;rewrite deploy/.env&lt;br&gt;FRONTEND_IMAGE / BACKEND_IMAGE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="535" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_dep3" value="compose -f&lt;br&gt;docker-compose.fallback.yml&lt;br&gt;pull + up -d --no-build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="535" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="n_dep4" value="docker image prune -f" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1210" y="535" width="340" height="55" as="geometry" />
        </mxCell>

        <!-- Jenkins lane -->
        <mxCell id="n_jenkins_lane" value="Jenkins — Jenkinsfile  (legacy, frontend-only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1580" height="250" as="geometry" />
        </mxCell>
        <mxCell id="n_j1" value="Checkout&lt;br&gt;checkout scm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="730" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_j2" value="Install &amp; quality gates&lt;br&gt;npm ci → lint →&lt;br&gt;type-check → test:run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="285" y="730" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_j3" value="Build App&lt;br&gt;npm run build (Vite)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="730" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_j4" value="Build Docker Image&lt;br&gt;frontend only&lt;br&gt;tags: BUILD_NUMBER, latest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="715" y="730" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_j5" value="Verify candidate&lt;br&gt;run on :8081&lt;br&gt;curl -f localhost:8081/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="930" y="730" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_j6" value="Deploy&lt;br&gt;stop/rm old, run new on&lt;br&gt;:8080 --restart unless-stopped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1145" y="730" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_j7" value="Cleanup (post: always)&lt;br&gt;stop/rm candidate,&lt;br&gt;docker image prune -f" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="730" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n_jenkins_note" value="Runs directly on the Docker host running the Jenkins agent (docker.sock bind-mounted)&lt;br&gt;— no SSH hop to a separate VPS, no compose, and no backend/simpleBEDB image at all.&lt;br&gt;A fundamentally different (and narrower) deploy model than GitHub Actions." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontStyle=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="830" width="1490" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n_legend" value="Legend&lt;br&gt;🟥 GitHub Actions (current)&lt;br&gt;⬜ Jenkins (legacy)&lt;br&gt;→ solid = sequential step&lt;br&gt;- - → dashed = job dependency&lt;br&gt;(needs:) or conditional gate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="320" height="150" as="geometry" />
        </mxCell>

