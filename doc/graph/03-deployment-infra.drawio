        <mxCell id="n_legend" value="Legend&lt;br&gt;🟧 Caddy (edge / TLS)&lt;br&gt;🟩 App services + Dockerfiles&lt;br&gt;🟪 Observability&lt;br&gt;🟨 Config / secrets / volumes&lt;br&gt;⬜ Tooling (Ansible, Makefile)&lt;br&gt;🟥 CI/CD (external ref)&lt;br&gt;- - → dashed = manual / optional /&lt;br&gt;override path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
